      187 +def _decollide(ys: list[float], floor_y: float, ceiling_y: flo
          +at) -> list[float]:                                           
      188 +    """Spread label positions so no two sit closer than LABEL_
          +GAP.                                                          
      189 +                                                              
      190 +    Walks the labels in vertical order pushing each below the 
          +previous one, then                                            
      191 +    slides the whole run back up if it overshot the plot, and 
          +clamps into range.                                            
      192 +    Returns positions in the original series order.           
      193 +    """                                                       
      194 +    order = sorted(range(len(ys)), key=lambda i: ys[i])       
      195 +    placed: dict[int, float] = {}                             
      196 +    previous = float("-inf")                                  
      197 +    for i in order:                                           
      198 +        y = max(ys[i], previous + LABEL_GAP)                  
      199 +        placed[i] = y                                         
      200 +        previous = y                                          
      201 +                                                              
      202 +    overshoot = previous - ceiling_y                          
      203 +    if overshoot > 0:                                         
      204 +        for i in placed:                                      
      205 +            placed[i] -= overshoot                            
      206 +                                                              
      207 +    span = LABEL_GAP * (len(ys) - 1)                          
      208 +    lowest = min(placed.values())                             
      209 +    if lowest < floor_y:                     # pushed off the 
          +top instead                                                   
      210 +        shift = floor_y - lowest                              
      211 +        for i in placed:                                      
      212 +            placed[i] = min(placed[i] + shift, floor_y + span)
      213 +    return [placed[i] for i in range(len(ys))]                
